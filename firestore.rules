rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tukar e-mel ini jika anda menukar ADMIN_EMAIL dalam js/config.js
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@hubmuzik.my';
    }

    // Senarai video: semua orang boleh baca, hanya admin boleh tulis
    match /hubs/{hub}/videos/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Markah murid: murid boleh hantar (create) sahaja; admin boleh baca & padam
    match /hubs/{hub}/scores/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'kelas', 'code', 'score', 'total', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.kelas is string && request.resource.data.kelas.size() > 0 && request.resource.data.kelas.size() <= 30
        && request.resource.data.code is string && request.resource.data.code.size() <= 10
        && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 20
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
